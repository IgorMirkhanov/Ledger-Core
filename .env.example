# Пример переменных для запуска сервиса вне docker (go run ./cmd/accounts).
# Полный список: internal/platform/config/config.go и Config в каждом cmd/*/main.go.
SERVICE_NAME=accounts
APP_ENV=local
LOG_LEVEL=debug
ADMIN_ADDR=:8091
GRPC_ADDR=:9091
POSTGRES_DSN=postgres://ledger:ledger@localhost:5432/accounts?sslmode=disable
KAFKA_BROKERS=localhost:19092
# transfers
ACCOUNTS_GRPC_ADDR=localhost:9091
# gateway
TRANSFERS_GRPC_ADDR=localhost:9092
REDIS_ADDR=localhost:6379
JWT_SECRET=local-dev-secret-change-me
RATE_LIMIT_RPS=50
RATE_LIMIT_IP_RPS=100
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Empty = ignore X-Forwarded-For (use RemoteAddr only).
TRUSTED_PROXY_CIDRS=

# --- production switches (APP_ENV=prod refuses to start with unsafe values) ---
# APP_ENV=prod
# POSTGRES_MIGRATE_ON_START=false   # migrations run as a separate Job: MIGRATE_ONLY=true
# KAFKA_AUTO_CREATE_TOPICS=false    # topics are created explicitly (deploy/kafka/topics.sh)
# GRPC_REFLECTION=false
# JWT_SECRET=<at least 32 random bytes>
